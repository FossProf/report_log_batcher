<Window x:Class="ReportLogBatcher.App.Dialogs.AppendConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Append to Report Log"
        Width="560"
        SizeToContent="Height"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock x:Name="TitleText"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <TextBlock x:Name="SourceText"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6" />
        <TextBlock x:Name="DestinationText"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6" />
        <TextBlock x:Name="TemplateText"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14" />

        <TextBlock Text="A backup of the report log will be created before it is modified. The source report is never changed."
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <Grid>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Append"
                        MinWidth="96"
                        Padding="10,4"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        AutomationProperties.Name="Append the approved record to the report log"
                        Click="OnAppendClicked" />
                <Button Content="Cancel"
                        MinWidth="96"
                        Padding="10,4"
                        IsCancel="True"
                        AutomationProperties.Name="Cancel appending to the report log"
                        Click="OnCancelClicked" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>