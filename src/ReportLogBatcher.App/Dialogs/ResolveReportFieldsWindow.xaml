<Window x:Class="ReportLogBatcher.App.Dialogs.ResolveReportFieldsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resolve Report Fields"
        Width="760"
        Height="680"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        KeyDown="OnWindowKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16">
                <TextBlock Text="Resolve Report Fields"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="Review or correct the parsed fields below. Blank required fields become &quot;N/A&quot; on approval; the Inspection Date requires a valid date. Your edits never modify the source SPIN report."
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Margin="0,2,0,12" />

                <TextBlock Text="Source Report:"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding SourceFileName}"
                           Margin="0,0,0,10"
                           ToolTip="{Binding SourceFilePath}" />

                <GroupBox Header="Header Fields"
                          Padding="8"
                          Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Report Number"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,4,10,4" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 x:Name="ReportNumberBox"
                                 Height="26"
                                 VerticalContentAlignment="Center"
                                 Margin="0,4,0,4"
                                 Text="{Binding ReportNumberText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReportNumberUnresolved}" Value="True">
                                            <Setter Property="Background" Value="#FFF3CD" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Inspection Date"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,4,10,4" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 x:Name="InspectionDateBox"
                                 Height="26"
                                 VerticalContentAlignment="Center"
                                 Margin="0,4,0,4"
                                 ToolTip="Formats: MM/dd/yyyy, M/d/yyyy, or yyyy-MM-dd"
                                 Text="{Binding InspectionDateText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InspectionDateUnresolved}" Value="True">
                                            <Setter Property="Background" Value="#FFF3CD" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Inspector First Name"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,4,10,4" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Height="26"
                                 VerticalContentAlignment="Center"
                                 Margin="0,4,0,4"
                                 Text="{Binding InspectorFirstNameText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InspectorFirstNameUnresolved}" Value="True">
                                            <Setter Property="Background" Value="#FFF3CD" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </GroupBox>

                <TextBlock Text="Description and location(s) of work inspected:"
                           FontWeight="SemiBold" />
                <TextBox Height="72"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         Margin="0,2,0,10"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding DescriptionOfWorkText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DescriptionOfWorkUnresolved}" Value="True">
                                    <Setter Property="Background" Value="#FFF3CD" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock Text="Drawing sheets and sections related to this work:"
                           FontWeight="SemiBold" />
                <TextBox Height="56"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         Margin="0,2,0,10"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding DrawingReferencesText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DrawingReferencesUnresolved}" Value="True">
                                    <Setter Property="Background" Value="#FFF3CD" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock Text="General observations/remarks:"
                           FontWeight="SemiBold" />
                <TextBox Height="80"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         Margin="0,2,0,10"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding GeneralObservationsText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GeneralObservationsUnresolved}" Value="True">
                                    <Setter Property="Background" Value="#FFF3CD" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock Text="Discrepancies and direction given:"
                           FontWeight="SemiBold" />
                <TextBox Height="80"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         Margin="0,2,0,10"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding DiscrepanciesText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DiscrepanciesUnresolved}" Value="True">
                                    <Setter Property="Background" Value="#FFF3CD" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock Text="Observations/Remarks on correction of discrepancies noted in previous inspections:"
                           FontWeight="SemiBold" />
                <TextBox Height="80"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         Margin="0,2,0,10"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding PreviousDiscrepancyCorrectionsText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviousDiscrepancyCorrectionsUnresolved}" Value="True">
                                    <Setter Property="Background" Value="#FFF3CD" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock Text="Diagnostics:"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding DiagnosticsText}"
                           Foreground="Gray"
                           Margin="0,2,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="16,8,16,12">
            <TextBlock Text="{Binding ValidationMessage}"
                       Foreground="#C0392B"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       MaxWidth="430"
                       Margin="0,0,12,0" />
            <Button Content="Approve"
                    Width="90"
                    Height="28"
                    IsDefault="True"
                    Click="OnApproveClicked" />
            <Button Content="Cancel"
                    Width="90"
                    Height="28"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    Click="OnCancelClicked" />
        </StackPanel>
    </Grid>
</Window>