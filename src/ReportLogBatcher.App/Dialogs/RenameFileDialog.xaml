<Window x:Class="ReportLogBatcher.App.Dialogs.RenameFileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename File"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnWindowKeyDown">
    <StackPanel Margin="14">
        <TextBlock Text="Renaming changes the actual source file on disk."
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />
        <TextBlock Text="The report keeps its current staged position."
                   Margin="0,4,0,12"
                   Foreground="Gray"
                   TextWrapping="Wrap" />

        <TextBlock Text="Current file name:" />
        <TextBox x:Name="CurrentFileNameBox"
                 Margin="0,2,0,10"
                 IsReadOnly="True"
                 Height="24"
                 VerticalContentAlignment="Center" />

        <TextBlock Text="New file name:" />
        <TextBox x:Name="NewFileNameBox"
                 Margin="0,2,0,8"
                 Height="24"
                 VerticalContentAlignment="Center"
                 AutomationProperties.Name="New file name" />

        <TextBlock x:Name="MessageText"
                   Foreground="#C0392B"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Rename"
                    Width="90"
                    IsDefault="True"
                    Click="OnRenameClicked" />
            <Button Content="Cancel"
                    Width="90"
                    Margin="8,0,0,0"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>