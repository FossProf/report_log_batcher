<Window x:Class="ReportLogBatcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report Log Batcher"
        Width="720"
        Height="520"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Project Report Log -->
        <GroupBox Grid.Row="0"
                  Header="Project Report Log"
                  Padding="10"
                  Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             VerticalContentAlignment="Center"
                             Height="26"
                             IsReadOnly="True"
                             AutomationProperties.Name="Project report log path"
                             Text="{Binding ReportLogPath, Mode=OneWay}" />
                    <Button Grid.Column="1"
                            Content="Browse..."
                            Width="96"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="Browse for project report log"
                            Command="{Binding BrowseReportLogCommand}" />
                </Grid>
                <TextBlock Margin="0,6,0,0"
                           Foreground="#C0392B"
                           TextWrapping="Wrap"
                           Text="{Binding ReportLogError}" />
            </StackPanel>
        </GroupBox>

        <!-- Finalized Reports Directory -->
        <GroupBox Grid.Row="1"
                  Header="Finalized Reports Directory"
                  Padding="10"
                  Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             VerticalContentAlignment="Center"
                             Height="26"
                             IsReadOnly="True"
                             AutomationProperties.Name="Finalized reports directory path"
                             Text="{Binding ReportsDirectoryPath, Mode=OneWay}" />
                    <Button Grid.Column="1"
                            Content="Browse..."
                            Width="96"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="Browse for finalized reports directory"
                            Command="{Binding BrowseReportsDirectoryCommand}" />
                </Grid>
                <TextBlock Margin="0,6,0,0"
                           Foreground="#C0392B"
                           TextWrapping="Wrap"
                           Text="{Binding ReportsDirectoryError}" />
            </StackPanel>
        </GroupBox>

        <!-- Batch Area -->
        <GroupBox Grid.Row="2"
                  Header="Batch"
                  Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="0,0,0,8"
                           FontWeight="SemiBold"
                           Text="{Binding BatchCount, StringFormat=Reports: {0}}" />

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <Button Content="Move Up"
                            MinWidth="76"
                            Padding="8,3"
                            Margin="0,0,6,0"
                            AutomationProperties.Name="Move selected report up"
                            Command="{Binding MoveUpCommand}" />
                    <Button Content="Move Down"
                            MinWidth="76"
                            Padding="8,3"
                            Margin="0,0,6,0"
                            AutomationProperties.Name="Move selected report down"
                            Command="{Binding MoveDownCommand}" />
                    <Button Content="Rename File"
                            MinWidth="90"
                            Padding="8,3"
                            Margin="0,0,6,0"
                            AutomationProperties.Name="Rename selected report"
                            Command="{Binding RenameFileCommand}" />
                    <Button Content="Remove from Batch"
                            MinWidth="120"
                            Padding="8,3"
                            Margin="0,0,6,0"
                            AutomationProperties.Name="Remove selected report from batch"
                            Command="{Binding RemoveFromBatchCommand}" />
                    <Button Content="Reload Batch"
                            MinWidth="90"
                            Padding="8,3"
                            AutomationProperties.Name="Reload batch from reports directory"
                            Command="{Binding ReloadBatchCommand}" />
                </StackPanel>

                <ListView Grid.Row="2"
                          ItemsSource="{Binding BatchEntries}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          BorderThickness="1"
                          BorderBrush="#CCCCCC">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="#"
                                            Width="48"
                                            DisplayMemberBinding="{Binding Sequence}" />
                            <GridViewColumn Width="Auto"
                                            Header="File">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileName}"
                                                   ToolTip="{Binding FullPath}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Status"
                                            Width="90"
                                            DisplayMemberBinding="{Binding Status}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock Grid.Row="3"
                           Margin="0,8,0,0"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Text="{Binding BatchEmptyMessage}" />

                <TextBlock Grid.Row="4"
                           Margin="0,8,0,0"
                           Foreground="#C0392B"
                           TextWrapping="Wrap"
                           Text="{Binding BatchError}" />

                <Button Grid.Row="5"
                        Content="Build Batch"
                        Width="120"
                        Height="28"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Build Batch"
                        Command="{Binding BuildBatchCommand}" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>