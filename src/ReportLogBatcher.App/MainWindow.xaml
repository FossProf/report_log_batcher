<Window x:Class="ReportLogBatcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report Log Batcher"
        Width="720"
        Height="520"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Project Report Log -->
        <GroupBox Grid.Row="0"
                  Header="Project Report Log"
                  Padding="10"
                  Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             VerticalContentAlignment="Center"
                             Height="26"
                             IsReadOnly="True"
                             AutomationProperties.Name="Project report log path"
                             Text="{Binding ReportLogPath, Mode=OneWay}" />
                    <Button Grid.Column="1"
                            Content="Browse..."
                            Width="96"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="Browse for project report log"
                            Command="{Binding BrowseReportLogCommand}" />
                </Grid>
                <TextBlock Margin="0,6,0,0"
                           Foreground="#C0392B"
                           TextWrapping="Wrap"
                           Text="{Binding ReportLogError}" />
            </StackPanel>
        </GroupBox>

        <!-- Finalized Reports Directory -->
        <GroupBox Grid.Row="1"
                  Header="Finalized Reports Directory"
                  Padding="10"
                  Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             VerticalContentAlignment="Center"
                             Height="26"
                             IsReadOnly="True"
                             AutomationProperties.Name="Finalized reports directory path"
                             Text="{Binding ReportsDirectoryPath, Mode=OneWay}" />
                    <Button Grid.Column="1"
                            Content="Browse..."
                            Width="96"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="Browse for finalized reports directory"
                            Command="{Binding BrowseReportsDirectoryCommand}" />
                </Grid>
                <TextBlock Margin="0,6,0,0"
                           Foreground="#C0392B"
                           TextWrapping="Wrap"
                           Text="{Binding ReportsDirectoryError}" />
            </StackPanel>
        </GroupBox>

        <!-- Batch Area -->
        <GroupBox Grid.Row="2"
                  Header="Batch"
                  Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="No reports yet."
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <Button Grid.Row="1"
                        Content="Build Batch"
                        Width="120"
                        Height="28"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Build Batch"
                        Command="{Binding BuildBatchCommand}" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>