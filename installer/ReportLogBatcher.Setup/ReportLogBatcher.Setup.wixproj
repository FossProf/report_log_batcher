<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>ReportLogBatcher</OutputName>
    <ProductName>Report Log Batcher</ProductName>
    <Title>Report Log Batcher</Title>
    <TargetFramework>native</TargetFramework>
    <Version>1.0.0</Version>
    <InstallerPlatform>x64</InstallerPlatform>
    <Description>Batches finalized SPIN reports into a project-specific Word report log.</Description>
    <!-- Avoid relying on the wixext package's build targets import (flaky in the SDK
         build); -ext below registers the extension deterministically instead. -->
    <ExcludeRestorePackageImports>true</ExcludeRestorePackageImports>
    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == ''">$(UserProfile)\.nuget\packages\</NuGetPackageRoot>
    <CompilerAdditionalOptions>-ext &quot;$(NuGetPackageRoot)wixtoolset.ui.wixext\5.0.2\wixext5\WixToolset.UI.wixext.dll&quot;</CompilerAdditionalOptions>

    <!-- Fresh self-contained publish of the app used by every installer build. -->
    <SetupPublishPath>$(MSBuildThisFileDirectory)obj\publish\win-x64</SetupPublishPath>
    <!-- Harvest generated by Generate-Harvest.ps1 from the publish output above. -->
    <GeneratedHarvestPath>$(MSBuildThisFileDirectory)obj\GeneratedFiles.wxs</GeneratedHarvestPath>
    <!-- Resolve the .NET host this build is running under so nested publish uses the same SDK. -->
    <DotNetHostPath Condition="'$(DotNetHostPath)' == ''">$([MSBuild]::NormalizePath('$(MSBuildToolsPath)\..\..\dotnet.exe'))</DotNetHostPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

  <Target Name="PublishApp" BeforeTargets="Compile;CoreCompile">
    <Exec Command="&quot;$(DotNetHostPath)&quot; publish &quot;$(MSBuildThisFileDirectory)..\..\src\ReportLogBatcher.App\ReportLogBatcher.App.csproj&quot; -c Release -r win-x64 --self-contained true -o &quot;$(SetupPublishPath)&quot; --nologo" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Generate-Harvest.ps1&quot; -SourcePath &quot;$(SetupPublishPath)&quot; -OutputPath &quot;$(GeneratedHarvestPath)&quot;" />
    <ItemGroup>
      <Compile Include="$(GeneratedHarvestPath)" />
    </ItemGroup>
  </Target>

</Project>